rules_version = '2';

// Reglas del campus. Se pegan en Firebase → Firestore Database → Reglas.
// - Cada alumno ve y maneja solo sus inscripciones.
// - Las clases de un curso solo se leen con la inscripción aprobada.
// - Jessica (y quien administra la página) aprueba pagos y edita las clases.
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['psp.jessicabenitez@gmail.com', 'matiezecaba19@gmail.com'];
    }

    function cursoValido(curso) {
      return curso in ['evaluacion', 'fundamentos', 'lectoescritura', 'orientacion', 'estudio', 'crianza'];
    }

    function textoCorto(valor, maximo) {
      return valor is string && valor.size() > 0 && valor.size() <= maximo;
    }

    match /inscripciones/{id} {
      allow read: if esAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      // El alumno pide la inscripción: queda pendiente de pago.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid', 'email', 'nombre', 'curso', 'estado', 'codigo', 'creada', 'actualizada'])
        && request.resource.data.uid == request.auth.uid
        && cursoValido(request.resource.data.curso)
        && id == request.auth.uid + '_' + request.resource.data.curso
        && request.resource.data.estado == 'pendiente_pago'
        && textoCorto(request.resource.data.nombre, 100)
        && textoCorto(request.resource.data.email, 200)
        && textoCorto(request.resource.data.codigo, 20)
        && request.resource.data.creada == request.time
        && request.resource.data.actualizada == request.time;

      // El alumno sube el comprobante (también si se lo rechazaron y lo vuelve a mandar).
      // Jessica aprueba o rechaza.
      allow update: if esAdmin()
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && resource.data.estado in ['pendiente_pago', 'rechazada']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'comprobante', 'actualizada'])
          && request.resource.data.estado == 'pendiente_aprobacion'
          && request.resource.data.comprobante is string
          && request.resource.data.comprobante.size() < 900000
          && request.resource.data.actualizada == request.time);

      allow delete: if esAdmin();
    }

    match /contenidos/{curso} {
      allow read: if esAdmin()
        || (request.auth != null
          && cursoValido(curso)
          && get(/databases/$(database)/documents/inscripciones/$(request.auth.uid + '_' + curso)).data.estado == 'aprobada');
      allow write: if esAdmin() && cursoValido(curso);
    }

    // Progreso de cada alumno en cada curso: módulos vistos y resultados de la autoevaluación.
    match /progreso/{uid}/cursos/{curso} {
      allow read: if esAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && cursoValido(curso)
        && request.resource.data.keys().hasOnly(['vistos', 'modulo', 'evaluaciones', 'actualizada'])
        && request.resource.data.vistos is list
        && request.resource.data.vistos.size() <= 40
        && request.resource.data.modulo is int
        && request.resource.data.evaluaciones is map
        && request.resource.data.evaluaciones.size() <= 40
        && request.resource.data.actualizada == request.time;
    }

    // Opiniones: el alumno con la inscripción aprobada deja la suya; Jessica decide cuáles se publican.
    // Las publicadas las puede leer cualquiera, porque se muestran en la página.
    match /opiniones/{id} {
      allow read: if esAdmin()
        || resource.data.publicada == true
        || (request.auth != null && id.matches('^' + request.auth.uid + '_[a-z]+$'));

      function opinionValida() {
        return request.auth != null
          && request.resource.data.keys().hasOnly(['uid', 'curso', 'nombre', 'estrellas', 'comentario', 'autoriza', 'publicada', 'actualizada'])
          && request.resource.data.uid == request.auth.uid
          && cursoValido(request.resource.data.curso)
          && id == request.auth.uid + '_' + request.resource.data.curso
          && request.resource.data.estrellas is int
          && request.resource.data.estrellas >= 1 && request.resource.data.estrellas <= 5
          && request.resource.data.comentario is string && request.resource.data.comentario.size() <= 500
          && textoCorto(request.resource.data.nombre, 60)
          && request.resource.data.autoriza is bool
          && request.resource.data.publicada == false
          && request.resource.data.actualizada == request.time
          && get(/databases/$(database)/documents/inscripciones/$(id)).data.estado == 'aprobada';
      }

      allow create: if opinionValida();
      allow update: if opinionValida()
        || (esAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['publicada'])
          && (request.resource.data.publicada == false || resource.data.autoriza == true));
      allow delete: if esAdmin();
    }

    // Certificados emitidos, para poder verificarlos con el código (página verificar.html).
    // Cualquiera que conozca el código puede consultar uno, pero no se pueden listar ni buscar por nombre.
    // Solo guarda lo mínimo: nombre, curso y fecha de emisión (nada de mail ni de pagos).
    // Lo crea la propia alumna al descargar su certificado, y únicamente si su inscripción está aprobada,
    // el código es el de esa inscripción y el nombre es el de la inscripción (que ella no puede modificar).
    match /certificados/{codigo} {
      function inscripcionPropia(curso) {
        return get(/databases/$(database)/documents/inscripciones/$(request.auth.uid + '_' + curso)).data;
      }

      allow get: if true;
      allow list: if esAdmin();

      allow create: if request.auth != null
        && codigo.matches('^JB-[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['nombre', 'curso', 'emitida'])
        && cursoValido(request.resource.data.curso)
        && request.resource.data.emitida == request.time
        && inscripcionPropia(request.resource.data.curso).estado == 'aprobada'
        && inscripcionPropia(request.resource.data.curso).codigo == codigo
        && inscripcionPropia(request.resource.data.curso).nombre == request.resource.data.nombre;

      // Jessica puede corregir el nombre (se hace junto con la corrección de la inscripción) y retirar o restituir
      // un certificado ("retirado"): si está retirado, la verificación dice que ya no es válido y la alumna no puede
      // volver a descargarlo. También puede borrarlo.
      allow update: if esAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'retirado'])
        && textoCorto(request.resource.data.nombre, 100)
        && (!('retirado' in request.resource.data) || request.resource.data.retirado is bool);
      allow delete: if esAdmin();
    }

    // Datos de cada cuenta: por ahora, hasta cuándo leyó las notificaciones.
    match /usuarios/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['notificacionesLeidas'])
        && request.resource.data.notificacionesLeidas == request.time;
    }

    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
